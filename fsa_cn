    echo "按住home键 + 开机键" 
    echo "4" && sleep 1 && echo "3" && sleep 1 && "$BINDIR"/irecovery -n && echo "2" && sleep 1 && echo "1" && sleep 1
    echo "松开开机键，按住home键"
    echo "8" && sleep 1 && echo "7" && sleep 1 && echo "6" && sleep 1 && echo "5" && sleep 1 && echo "4" && sleep 1 && echo "3" && sleep 1 && echo "2" && sleep 1 && echo "1" && sleep 1
fi
echo "现在你的设备应该已经进入了DFU模式...应该吧."
echo "如果没有，请重新运行此脚本。骚瑞"
sleep 3
echo "本脚本将抹除设备所有数据！（iOS 10及以上）"
echo "按Enter继续."
read -s
if [[ "$MODEL" == iPhone11* || "$MODEL" == iPhone12* || "$MODEL" == iPad11* || "$MODEL" == iPad12,1 || "$MODEL" == iPad12,2 ]]; then
    echo "现在将设备插入到已经刷好usbliter8固件的开发板上来进入破解DFU模式"
    echo "你可以检查那颗LED灯的状态来判断是否破解成功."
    echo "更多信息在此阅读： https://github.com/prdgmshift/usbliter8"
    while true; do
        echo "在破解后，按 Enter"
        read -s
        echo "检查DFU状态..."
        sleep 3
        PWNA12=$("$BINDIR"/irecovery -q | grep PWND)
        if [[ $PWNA12 == *usbliter8* ]]; then
            echo "设备已成功破解!"
            break 
        else
            echo "破解失败，请重试."
            sleep 2
        fi
    done
    echo "请等待提取ramdisk..."
    ./makebootfiles.sh "$VERSION" ./sshrd-u8/firmwares.json
    if [[ $? -ne 0 ]]; then
        echo "我去咋失败了"
        exit 1
    fi
    echo "提取成功！准备引导ramdisk..."
    sleep 3
    ./spiro.sh boot "$rdu8dir"
    if [[ $? -ne 0 ]]; then
        echo "我去咋失败了"
        exit 1
    fi
    echo "准备连接到SSH..."
else
