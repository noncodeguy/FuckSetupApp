        $BINDIR/irecovery -n
        exit 1
    else
        boardcfgu8=$("$BINDIR"/irecovery -q | grep MODEL | sed 's/MODEL: //')
        deviceidu8=$("$BINDIR"/irecovery -q | grep PRODUCT | sed 's/PRODUCT: //')
        rdu8dir="$boardcfgu8-$deviceidu8"
        sleep 3
