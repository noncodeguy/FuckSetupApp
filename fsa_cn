if [[ "$MODEL" == iPhone9* || "$MODEL" == iPhone10* || "$MODEL" == iPhone11* || "$MODEL" == iPhone12* ]]; then 
    echo "请再次确保设备在正常/恢复模式，如果不是请按Ctrl + C退出"
    sleep 5
