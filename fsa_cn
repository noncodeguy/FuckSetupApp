        echo "再松开开机键，按住音量减键10秒"
        echo "准备好后请按Enter，教程将会在按Enter后开始"
        read -s
        echo "准备好..." 
        echo "3" && sleep 1 && echo "2" && sleep 1 && echo "1" && sleep 1
        echo "按住音量减键 + 开机键" 
        echo "4" && sleep 1 && echo "3" && sleep 1 && "$BINDIR"/irecovery -n && echo "2" && sleep 1 && echo "1" && sleep 1
        echo "松开开机键，按住音量减键"
        echo "8" && sleep 1 && echo "7" && sleep 1 && echo "6" && sleep 1 && echo "5" && sleep 1 && echo "4" && sleep 1 && echo "3" && sleep 1 && echo "2" && sleep 1 && echo "1" && sleep 1
