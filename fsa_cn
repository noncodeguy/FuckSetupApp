ver_ge() {
    local sorted
    sorted=$(printf '%s\n' "$1" "$2" | sort -V | head -n1)
    [[ "$sorted" == "$2" ]]
}
ver_le() {
    local sorted
    sorted=$(printf '%s\n' "$1" "$2" | sort -V | head -n1)
    [[ "$sorted" == "$1" ]]
}

REMOTE_SCRIPT=""

if ver_ge "$VERSION" "6.0" && ver_le "$VERSION" "9.3.6"; then
    REMOTE_SCRIPT="
        echo 'Mounting filesystem...'
        mount_hfs /dev/disk0s1s1
        echo 'Deleting setup.app...'
        rm -rf /mnt1/Applications/Setup.app
        echo 'Rebooting...'
        /sbin/reboot
    "
elif ver_ge "$VERSION" "10.0" && ver_le "$VERSION" "10.2.1"; then
    REMOTE_SCRIPT="
        echo 'Mounting filesystem...'
        mount_hfs /dev/disk0s1s1
        echo 'Deleting setup.app'
        rm -rf /mnt1/Application/Setup.app
        echo 'Erasing device...bye bye data'
        /usr/sbin/nvram oblit-inprogress=5
    "
elif ver_ge "$VERSION" "10.3" && ver_le "$VERSION" "11.2.6"; then
    REMOTE_SCRIPT="
        echo 'Mounting filesystem...'
        mount_apfs /dev/disk0s1s1
        echo 'Deleting setup.app'
        rm -rf /mnt1/Application/Setup.app
        echo 'Erasing device...bye bye data'
        /usr/sbin/nvram oblit-inprogress=5
    "
elif ( ver_ge "$VERSION" "11.3" && ver_le "$VERSION" "12.4.4" ) || ( ver_ge "$VERSION" "13.0" && ver_le "$VERSION" "13.2.3" ); then
    REMOTE_SCRIPT="
        echo 'Mounting filesystem...'
        mount_apfs /dev/disk0s1s1
        echo 'Deleting setup.app'
        rm -rf /mnt1/Application/Setup.app
        echo 'Finding and rebuilding system snapshot...'
        snapname=\$(snaputil -l /mnt1)
        snaputil -d \"\$snapname\" /mnt1
        snaputil -c \"\$snapname\" /mnt1
        echo 'Erasing device...bye bye data'
        /usr/sbin/nvram oblit-inprogress=5
    "
else
    REMOTE_SCRIPT="
        echo 'Unsupported system version. READ THE README smartahh'
        /sbin/reboot
        exit 0
    "
fi

killall iproxy 2>/dev/null | true
"$BINDIR/iproxy" 2222 22 >/dev/null 2>&1 &
IPROXY_PID=$!

for i in {1..10}; do
    if nc -z localhost 2222 2>/dev/null; then
        break
    fi
    sleep 1
    if ! kill -0 $IPROXY_PID 2>/dev/null; then
        echo "where is iproxy?"
        exit 1
    fi
    sleep 1
    if [[ $i -eq 10 ]]; then
        echo "iproxy hate you"
        kill $IPROXY_PID 2>/dev/null
        exit 1
    fi
done

sleep 3
"$BINDIR"/sshpass -p 'alpine' ssh -T -o HostKeyAlgorithms=+ssh-rsa StrictHostKeyChecking=no -p2222 root@localhost << EOF
    echo "准备移除Setup.app..."
    $REMOTE_SCRIPT
EOF
echo "现在你的设备应成功绕过了激活锁...应该吧"
