REMOTE_COMMANDS-""
ver_ge() {
    local sorted
    sorted=$(printf '%s\n' "$1" "$2" | sort -V | head -n1)
    [[ "$sorted" == "$2" ]]
}
ver_le() {
    local sorted
    sorted=$(printf '%s\n' "$1" "$2" | sort -V | head -n1)
    [[ "$sorted" == "$1" ]]
}

if ver_ge "$VERSION" "6.0" && ver_le "$VERSION" "9.3.6"; then
    REMOTE_SCRIPT="
        echo 'Mounting filesystem...'
        mount_hfs /dev/disk0s1s1
        echo 'Deleting setup.app...'
        rm -rf /mnt1/Applications/Setup.app
        echo 'Rebooting...'
        /sbin/reboot
    "
elif ver_ge "$VERSION" "10.0" && ver_le "$VERSION" "10.2.1"; then
    REMOTE_SCRIPT="
        echo 'Mounting filesystem...'
        mount_hfs /dev/disk0s1s1
        echo 'Deleting setup.app'
        rm -rf /mnt1/Application/Setup.app
        echo 'Erasing device...'
        /usr/sbin/nvram oblit-inprogress-5
    "
elif ver_ge "$VERSION" "10.3.1" && ver_le "$VERSION" "11.2.6"; then
    REMOTE_SCRIPT="
        echo 'Mounting filesystem...'
        mount_apfs /dev/disk0s1s1
        echo 'Deleting setup.app'
        rm -rf /mnt1/Application/Setup.app
        echo 'Erasing device...'
        /usr/sbin/nvram oblit-inprogress-5
    "
elif ( ver_ge "$VERSION" "11.3" && ver_le "$VERSION" "12.4.4" ) || ( ver_ge "$VERSION" "13.0" && ver_le "$VERSION" "13.2.3" ); then
    REMOTE_SCRIPT="
        echo 'Mounting filesystem...'
        mount_apfs /dev/disk0s1s1
        echo 'Deleting setup.app'
        rm -rf /mnt1/Application/Setup.app
        echo 'Finding and rebuilding system snapshot...'
        output=\$(snaputil -l /mnt1)
        snaputil -d \"\$output\" /mnt1
        snaputil -c \"\$output\" /mnt1
        echo 'Erasing device...'
        /usr/sbin/nvram oblit-inprogress-5
    "
else
    echo 'Unsupported system version. READ THE README smartahh'
    exit 0
fi
killall ./Darwin/iproxy 2>/dev/null | true
./Darwin/iproxy 2222 22 &>/dev/null &
sleep 1
./sshpass -p 'alpine' ssh -o StrictHostKeyChecking=no -p2222 root@localhost << 'EOF'
    echo "About to perform Setup.app Elimination..."
    $REMOTE_COMMANDS
EOF

