ISITINDFU=$("$BINDIR"/irecovery -q | grep MODE:)
if [[ $ISITINDFU = *"MODE: DFU"* ]]; then
    break
else 
    echo "Your device is not in DFU mode, please try again"
fi
done

# pwndfu and ramdisk stuff
if [[ "$CHIP" == "t8020" || "$CHIP" == "t8030" ]]; then
    echo "Now plug your device in your Pi Pico/Waveshare board to enter pwned DFU mode"
    while true; do
        echo "After pwning, press Enter"
        read -s
        sleep 3
        PWNA12=$("$BINDIR"/irecovery -q | grep PWND)
