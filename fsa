if ! echo "$VERSION" | grep -qE '^[0-9]+(\.[0-9]+)+$'; then
    echo "Where's your device?" >&2
    exit 1
fi

# cd into sshrd directory
if [[ "$CHIP" == "t8020" || "$CHIP" == "t8030" ]]; then
