    VERSION=$(./ideviceinfos/ideviceinfo_linux -k ProductVersion 2>&1)
    MODEL=$(./ideviceinfos/ideviceinfo_linux -k ProductType 2>&1)
    CHIP=$(./ideviceinfos/ideviceinfo_linux -k HardwarePlatform 2>&1)
