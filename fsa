elif [[ "$CHIP" == "s5l8960x" || "$CHIP" == "t7000" || "$CHIP" == "t7001" || "$CHIP" == "s8000" || "$CHIP" == "s8001" || "$CHIP" == "s8003" || "$CHIP" == "t8010" || "$CHIP" == "t8011" || "$CHIP" == "t8015" || "$CHIP" == "s5l8920x" || "$CHIP" == "s5l8922x" || "$CHIP" == "s5l8930x" || "$CHIP" == "s5l8950x" || "$CHIP" == "s5l8955x" || "$CHIP" == "s5l8940x" || "$CHIP" == "s5l8945x" || "$CHIP" == "s5l895Xx" ]]; then
