# some functions

get_irec_field() {
    local key="$1"
    echo "$IREC_OUT" | grep "^${key}:" | cut -d: -f2- | tr -d '[:space:]'
}

gotodfu () {
    while true; do 
        local isitindfu
        local button
        local IREC_OUT 
        local srtg 
        local ecid
        local answer
        if [[ "$CHIP" == "s5l8940x" || "$CHIP" == "s5l8945x" ]]; then
            echo "You're using an A5(X) device, right? For some reason, you cannot enter pwned DFU like other 32bit device does"
            echo "Please read the Q0 in tutorial.txt and enter kDFU, and KEEP YOUR TERMINAL WINDOW THERE! Press Enter after entered kDFU"
            read -s
            IREC_OUT=$("$BINDIR"/irecovery -q 2>/dev/null)
            srtg=$(echo "$IREC_OUT" | grep '^SRTG:' | cut -d: -f2- | tr -d '[:space:]')
            ecid=$(echo "$IREC_OUT" | grep '^ECID:' | cut -d: -f2- | tr -d '[:space:]')
            if [ -z "$srtg" ] && [ -n "$ecid" ]; then
                echo "Entered kDFU mode, continuing..."
                break
            else
                echo "Not in kDFU, Maybe retry? (Press 'y' to retry or other keys to exit)"
                read -s answer
                if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                    sleep 2
                else
                    echo "Exiting..."
                    exit 1
                fi
            fi
        fi
        if [[ "$MODEL" == iPhone9* || "$MODEL" == iPhone10* || "$MODEL" == iPhone11* || "$MODEL" == iPhone12* ]]; then 
            button="Volume Down"
        else
            button="Home"
        fi
        sleep 3
        echo "You need to press $button + Power for 4s, then release Power and keep holding $button for 10s"  
        echo "Press Enter when ready, the guide will start after pressing Enter"
        read -s
        echo "Get prepared..." 
        echo "3" && sleep 1 && echo "2" && sleep 1 && echo "1" && sleep 1
        echo "Press Power & ${button} button" 
        echo "4" && sleep 1 && echo "3" && sleep 1 && "$BINDIR"/irecovery -n || true && echo "2" && sleep 1 && echo "1" && sleep 1
        echo "Release Power button, hold ${button} button"
        echo "8" && sleep 1 && echo "7" && sleep 1 && echo "6" && sleep 1 && echo "5" && sleep 1 && echo "4" && sleep 1 && echo "3" && sleep 1 && echo "2" && sleep 1 && echo "1" && sleep 1
        isitindfu=$("$BINDIR"/irecovery -q | grep MODE:)
        if [[ "$isitindfu" == "MODE: DFU" ]]; then 
            echo "Successfully entered DFU mode!"
            break
        else
            echo "Failed entering DFU mode. Press Enter to restart tutorial..."
            read -s
        fi
    done
}

gotorec () {
    export UDID=$("$BINDIR"/ideviceinfo -k UniqueDeviceID)
    if [ -z "$UDID" ]; then
        echo "Failed to get UDID, is your device connected and trusted?"
        exit 1
    fi
    while true; do
        local mode
        local answer
        echo "Entering recovery mode..."
        "$BINDIR"/ideviceenterrecovery "$UDID"
        sleep 5
        echo "Checking..."
        mode="$("$BINDIR"/irecovery -q | grep MODE:)"
        if [[ "$mode" != "MODE: Recovery" ]]; then
            echo "Your device is not in recovery mode. Press 'y' to restart tutorial or other keys to exit"
            read -s answer
            if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                sleep 2
            else
                echo "Exiting..."
                exit 1
            fi
        else
            sleep 1
            break
        fi
    done
    gotodfu
}

# version number sorters
ver_ge() {
    local IFS=.
    local i
    local -a v1=($1) v2=($2)
    for ((i=${#v1[@]}; i<${#v2[@]}; i++)); do v1[i]=0; done
    for ((i=0; i<${#v1[@]}; i++)); do
        [[ -z "${v2[i]}" ]] && v2[i]=0
        if ((10#${v1[i]} > 10#${v2[i]})); then return 0; fi
        if ((10#${v1[i]} < 10#${v2[i]})); then return 1; fi
    done
    return 0
}

ver_le() {
    local IFS=.
    local i
    local -a v1=($1) v2=($2)
    for ((i=${#v1[@]}; i<${#v2[@]}; i++)); do v1[i]=0; done
    for ((i=0; i<${#v1[@]}; i++)); do
        [[ -z "${v2[i]}" ]] && v2[i]=0
        if ((10#${v1[i]} > 10#${v2[i]})); then return 1; fi
        if ((10#${v1[i]} < 10#${v2[i]})); then return 0; fi
    done
    return 0
}

