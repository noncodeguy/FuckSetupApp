    else
        boardcfgu8=$("$BINDIR"/irecovery -q | grep MODEL | sed 's/MODEL: //')
        deviceidu8=$("$BINDIR"/irecovery -q | grep PRODUCT | sed 's/PRODUCT: //')
        rdu8dir="$boardcfgu8-$deviceidu8"
        sleep 3
        echo "You need to press Volume Down button + power button for 4s, Then release Volume Down button, for 10s"
        echo "Press Enter when ready, the guide will start after pressing Enter"
        read -s
        echo "Get prepared..." 
        echo "3" && sleep 1 && echo "2" && sleep 1 && echo "1" && sleep 1
